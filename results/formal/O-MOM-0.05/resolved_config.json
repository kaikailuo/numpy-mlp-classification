{
  "compute": {
    "backend": "cpu",
    "dtype": "float32"
  },
  "data": {
    "name": "mnist",
    "preprocess": "scale01",
    "root": "data/raw/mnist",
    "split_seed": 20261011,
    "val_size": 5000
  },
  "loss": {
    "l1_lambda": 0.0,
    "l2_lambda": 0.0,
    "name": "cross_entropy"
  },
  "model": {
    "dims": [
      784,
      128,
      64,
      10
    ],
    "dropout": 0.0,
    "dropout_seed": 44,
    "init_seed": 42
  },
  "optimizer": {
    "learning_rate": 0.05,
    "momentum": 0.9,
    "name": "momentum"
  },
  "run": {
    "label": "O-MOM: lr=0.05",
    "name": "mnist_momentum_lr0.05",
    "output_root": "results"
  },
  "training": {
    "batch_size": 128,
    "checkpoint_best": true,
    "epochs": 12,
    "selection": "val_accuracy_then_val_ce",
    "shuffle_seed": 43
  }
}
